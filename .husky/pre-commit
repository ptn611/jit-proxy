#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

cargo fmt -- --check
cargo clippy -p jit-proxy -- -D warnings -D clippy::expect_used -D clippy::panic
cargo clippy -p jit-proxy --tests -- -D warnings
cargo test --quiet
yarn prettify
yarn lint
cd ts/sdk
# `tsc` trần không có trong PATH của husky (chỉ `node_modules/.bin` được thêm
# khi chạy qua yarn) ⇒ gọi tường minh binary đã cài.
../../node_modules/.bin/tsc